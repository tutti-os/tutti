{
  "$schema": "../../schemas/core/event-definition.schema.json",
  "topic": "preferences.agent.session.launch.mode.patch.requested",
  "version": 1,
  "direction": "client->server",
  "owner": "core",
  "scope": "desktop",
  "payloadSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["workspaceId", "projectSectionKey", "mode"],
    "properties": {
      "workspaceId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "projectSectionKey": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "mode": {
        "type": "string",
        "enum": ["local", "worktree"]
      }
    }
  }
}
