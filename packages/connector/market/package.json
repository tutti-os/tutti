      "./openapi/connector-market.v1.yaml": "./openapi/connector-market.v1.yaml",
      "./renderer": {
        "types": "./dist/renderer/index.d.ts",
        "import": "./dist/renderer/index.js"
      },
      "./services": {
        "types": "./dist/services/index.d.ts",
