{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutti.dev/schemas/agent-activity-live-event.json",
  "title": "AgentActivityLiveEvent",
  "description": "Lossy optimistic AgentGUI event contract. The public agent.activity.updated WebSocket may carry the same live variants before canonical confirmation.",
  "oneOf": [
    {
      "$ref": "#/$defs/runtimeActivityUpdate"
    },
    {
      "$ref": "#/$defs/messageDelta"
    },
    {
      "$ref": "#/$defs/turnUpdate"
    },
    {
      "$ref": "#/$defs/interactionUpdate"
    },
    {
      "$ref": "#/$defs/interactionSnapshot"
    },
    {
      "$ref": "#/$defs/sessionAudit"
    }
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["workspaceId", "agentSessionId", "eventType", "data"],
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "agentSessionId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtimeActivityUpdate": {
      "$ref": "../../../../events/protocol/definitions/agent/activity.updated.event.json#/payloadSchema/oneOf/0"
    },
    "messageDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "agentSessionId", "eventType", "data"],
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "agentSessionId": {
          "type": "string",
          "minLength": 1
        },
        "eventType": {
          "const": "message_delta"
        },
        "data": {
          "$ref": "#/$defs/messageDeltaData"
        }
      }
    },
    "messageDeltaData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "agentSessionId",
        "messageId",
        "turnId",
        "role",
        "kind",
        "occurredAtUnixMs"
      ],
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "agentSessionId": {
          "type": "string",
          "minLength": 1
        },
        "messageId": {
          "type": "string",
          "minLength": 1
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "occurredAtUnixMs": {
          "type": "integer",
          "minimum": 1
        },
        "content": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "text"],
              "properties": {
                "operation": {
                  "const": "append_text"
                },
                "text": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "value"],
              "properties": {
                "operation": {
                  "const": "set"
                },
                "value": true
              }
            }
          ]
        },
        "toolOutput": {
          "description": "Provider-normalized mutation of payload.output.text for an appendable tool output stream.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "text"],
              "properties": {
                "operation": {
                  "const": "set"
                },
                "text": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "text", "offsetBytes"],
              "properties": {
                "operation": {
                  "const": "append_text"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "offsetBytes": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "payloadSet": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          }
        },
        "payloadUnset": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string"
        },
        "semantics": {
          "type": "object"
        },
        "startedAtUnixMs": {
          "type": "integer",
          "minimum": 0
        },
        "completedAtUnixMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": ["content"]
        },
        {
          "required": ["toolOutput"]
        },
        {
          "required": ["payloadSet"]
        },
        {
          "required": ["payloadUnset"]
        },
        {
          "required": ["status"]
        },
        {
          "required": ["semantics"]
        },
        {
          "required": ["startedAtUnixMs"]
        },
        {
          "required": ["completedAtUnixMs"]
        }
      ]
    },
    "turnUpdate": {
      "$ref": "../../../../events/protocol/definitions/agent/activity.updated.event.json#/payloadSchema/oneOf/7"
    },
    "interactionUpdate": {
      "$ref": "../../../../events/protocol/definitions/agent/activity.updated.event.json#/payloadSchema/oneOf/8"
    },
    "interactionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "agentSessionId", "eventType", "data"],
      "properties": {
        "workspaceId": { "type": "string", "minLength": 1 },
        "agentSessionId": { "type": "string", "minLength": 1 },
        "eventType": { "const": "interaction_snapshot" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workspaceId",
            "agentSessionId",
            "eventType",
            "occurredAtUnixMs",
            "rootTurnId",
            "interactions"
          ],
          "properties": {
            "workspaceId": { "type": "string", "minLength": 1 },
            "agentSessionId": { "type": "string", "minLength": 1 },
            "eventType": { "const": "interaction_snapshot" },
            "occurredAtUnixMs": { "type": "integer", "minimum": 0 },
            "rootTurnId": { "type": "string", "minLength": 1 },
            "interactions": {
              "type": "array",
              "items": {
                "$ref": "../../../../events/protocol/definitions/agent/activity.updated.event.json#/payloadSchema/oneOf/8/properties/data/properties/interaction"
              }
            }
          }
        }
      }
    },
    "sessionAudit": {
      "$ref": "../../../../events/protocol/definitions/agent/activity.updated.event.json#/payloadSchema/oneOf/6"
    }
  }
}
