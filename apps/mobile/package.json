{
  "name": "@tutti-os/mobile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "android": "pnpm android:aar && react-native run-android",
    "android:aar": "make -C android android-aar",
    "build:android": "pnpm android:aar && cd android && ./gradlew app:assembleDebug",
    "build:ios": "pnpm ios:pods && react-native build-ios --mode Debug",
    "check": "pnpm typecheck && pnpm test && pnpm check:android-bindings && pnpm check:ios-bindings",
    "check:android-bindings": "make -C android android-bindings-check",
    "check:ios-bindings": "make -C ios ios-bindings-check",
    "ios": "pnpm ios:pods && react-native run-ios",
    "ios:framework": "make -C ios ios-framework",
    "ios:pods": "pnpm ios:framework && cd ios && pod install",
    "start": "react-native start",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@rn-primitives/portal": "1.5.2",
    "@react-navigation/native": "7.3.14",
    "@react-navigation/native-stack": "7.18.6",
    "@tutti-os/agent-activity-core": "workspace:*",
    "@tutti-os/agent-activity-tuttid-adapter": "workspace:*",
    "@tutti-os/agent-gui": "workspace:*",
    "@tutti-os/auth-bridge": "workspace:*",
    "@tutti-os/client-tuttid-ts": "workspace:*",
    "@tutti-os/infra": "0.1.0",
    "@tutti-os/ui-system": "workspace:*",
    "nativewind": "4.2.6",
    "react": "19.2.6",
    "react-native": "0.86.0",
    "react-native-css-interop": "0.2.6",
    "react-native-enriched-markdown": "0.7.4",
    "react-native-gesture-handler": "3.1.0",
    "react-native-reanimated": "4.5.3",
    "react-native-screens": "4.26.2",
    "react-native-safe-area-context": "5.6.2",
    "react-native-worklets": "0.11.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@babel/preset-env": "7.29.0",
    "@babel/runtime": "7.29.2",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/codegen": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/gradle-plugin": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.15",
    "@types/react-test-renderer": "19.1.0",
    "hermes-compiler": "250829098.0.14",
    "jest": "29.7.0",
    "react-test-renderer": "19.2.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
